# ==============================================================================
# Plataforma de IA como Servico - Variaveis de Ambiente (.env.example)
# Copie para .env:   cp .env.example .env
# Os valores abaixo ja funcionam para subir localmente com o docker compose.
# Em producao (servidor publico), TROQUE o JWT_SECRET/JWT_SEGREDO.
# ==============================================================================

# --- Etapa 1: API Gateway e Autenticacao JWT ---
GATEWAY_PORT=8000
PORT=8000
JWT_SECRET=super-segredo-sd-2026-faesa-jwt-token-key-32bytes
JWT_SEGREDO=super-segredo-sd-2026-faesa-jwt-token-key-32bytes
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# --- Descoberta de servicos (os servicos se acham pelo NOME no docker compose) ---
URL_INFERENCIA=http://inferencia:8001
INFERENCE_URL=http://inferencia:8001
REDIS_URL=redis://redis:6379/0
BROKER_URL=redis://redis:6379/0

# --- Timeouts e retencao de jobs (LGPD: resultados expiram apos 1h) ---
HTTP_TIMEOUT_SECONDS=10.0
JOB_TTL_SECONDS=3600

# --- Etapa 2: Inferencia e Banco Vetorial ---
VECTOR_DB_URL=http://qdrant:6333
VECTOR_COLLECTION=documentos
LLM_API_KEY=

# --- Etapa 4: Observabilidade (OpenTelemetry -> Jaeger) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# --- Etapa 5: Deploy (dominio usado pelo Caddy para gerar o HTTPS) ---
DOMAIN=seudominio.duckdns.org
