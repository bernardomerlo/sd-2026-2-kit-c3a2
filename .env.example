# ==============================================================================
# Plataforma de IA como Servico - Variaveis de Ambiente (.env.example)
# Etapa 1: API Gateway, Autenticacao JWT e Seguranca
# ==============================================================================

# Porta do API Gateway
GATEWAY_PORT=8000
PORT=8000

# Segredo para assinatura criptografica do token JWT (HS256)
JWT_SECRET=super-segredo-sd-2026-faesa-jwt-token-key-32bytes
JWT_SEGREDO=super-segredo-sd-2026-faesa-jwt-token-key-32bytes
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Conectividade e Descoberta de Servicos (URLs via env vars)
URL_INFERENCIA=http://inferencia:8001
INFERENCE_URL=http://inferencia:8001
REDIS_URL=redis://redis:6379/0
BROKER_URL=redis://redis:6379/0

# Politica de Retencao temporaria de jobs (LGPD) e timeouts
HTTP_TIMEOUT_SECONDS=10.0
JOB_TTL_SECONDS=3600
