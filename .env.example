# ==============================================================================
# Plataforma de IA como Servico - Variaveis de Ambiente (.env.example)
# Etapa 1: API Gateway, Autenticacao JWT e Seguranca
# ==============================================================================

# Porta do API Gateway
GATEWAY_PORT=8000
PORT=8000

# Segredo para assinatura criptografica do token JWT (HS256)
JWT_SECRET=super-segredo-sd-2026-faesa-jwt-token-key-32bytes
JWT_SEGREDO=super-segredo-sd-2026-faesa-jwt-token-key-32bytes
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Conectividade e Descoberta de Servicos (URLs via env vars)
URL_INFERENCIA=http://inferencia:8001
INFERENCE_URL=http://inferencia:8001
REDIS_URL=redis://redis:6379/0
BROKER_URL=redis://redis:6379/0

# Politica de Retencao temporaria de jobs (LGPD) e timeouts
HTTP_TIMEOUT_SECONDS=10.0
JOB_TTL_SECONDS=3600

# ==============================================================================
# Etapa 2: Servico de Inferencia + Banco Vetorial (Qdrant)
# Todas opcionais: os padroes rodam 100% offline (LLM simulado, embeddings locais).
# ==============================================================================

# Banco vetorial (container `qdrant` no docker-compose)
VECTOR_DB_URL=http://qdrant:6333
VECTOR_COLLECTION=documentos_tecnicos
# Somente para Qdrant Cloud (deploy opcao B). Deixe vazio com o Qdrant do compose.
VECTOR_DB_API_KEY=
# Carrega os 10 documentos tecnicos ficticios no startup (idempotente)
SEED_ON_STARTUP=true
# Quanto tempo o servico insiste em conectar ao banco se ele ainda estiver subindo
VECTOR_DB_STARTUP_TIMEOUT_SECONDS=120

# Modelo scikit-learn e embeddings locais
MODEL_PATH=/app/model/modelo.joblib
EMBEDDING_DIM=1024

# LLM: SEM chave = modo simulado (offline). Com chave = API real (formato chat-completions);
# se a API falhar, o servico degrada para o simulado em vez de falhar.
# ATENCAO (LGPD): com chave, a pergunta e o contexto sao enviados ao provedor do LLM.
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
